{"columns": ["Audio", "Reference", "Prediction"], "data": [["Audio", "\u03c4\u03b1 \u03b4\u03ac\u03c7\u03c4\u03c5\u03bb\u03b1 \u03c4\u03bf\u03c5 \u03c6\u03b1\u03b9\u03bd\u03cc\u03c4\u03b1\u03bd \u03bd\u03b1 \u03b3\u03bb\u03b9\u03c3\u03c4\u03c1\u03ac\u03bd\u03b5 \u03bc\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03c0\u03bf\u03c1\u03c3\u03b5\u03bb\u03ac\u03bd\u03b9\u03bd\u03b7 \u03ba\u03bf\u03cd\u03c0\u03b1", "\u03c4\u03b1 \u03b4\u03ac\u03c7\u03c4\u03c5\u03bb\u03ac \u03c4\u03bf\u03c5 \u03c6\u03b1\u03b9\u03bd\u03cc\u03c4\u03b1\u03bd \u03bd\u03b1 \u03b3\u03bb\u03b9\u03c3\u03c4\u03c1\u03ac\u03bd\u03b5 \u03bc\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03c0\u03bf\u03c1\u03c3\u03b5\u03bb\u03ac\u03bd\u03b9\u03bd\u03b7 \u03ba\u03bf\u03cd\u03c0\u03b1"], ["Audio", "\u03bc\u03b5\u03b9\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 45 - 54 \u03ba\u03b1\u03b9 \u03b5\u03be\u03b1\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c4\u03b5\u03bb\u03b5\u03af\u03c9\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u03c7\u03ac\u03c1\u03c4\u03b7 \u03b3\u03b9\u03b1 \u03c4\u03bf\u03c5\u03c2 55 \u03ba\u03b1\u03b9 \u03ac\u03bd\u03c9.", "\u03c4\u03bf \u03ba\u03ac\u03bd\u03b5\u03b9 \u03b7 \u03b4\u03b9\u03b1\u03ba\u03bf\u03c0\u03ae \u03c4\u03bf\u03c5'45 \u03c4\u03bf\u03c5'64, \u03ba\u03b1\u03b9 \u03c4\u03b5\u03bb\u03b5\u03af\u03c9\u03c2 \u03bd\u03c4\u03c1\u03bf\u03c0\u03ae \u03b1\u03c0\u03cc \u03c4\u03bf'65 \u03b3\u03b9\u03b1 \u03c4\u03bf'65."], ["Audio", "\u03ba\u03b1\u03b9 \u03c3\u03b5\u03b9\u03c2, \u03c4\u03b9 \u03ba\u03ac\u03bd\u03b1\u03c4\u03b5 ;", "\u03ba\u03b1\u03b9 \u03c3\u03b5\u03b9\u03c2, \u03c4\u03b9 \u03ba\u03ac\u03bd\u03b1\u03c4\u03b5 ;"], ["Audio", "\u03c5\u03c0\u03ae\u03c1\u03c7\u03b1\u03bd \u03c0\u03ac\u03c1\u03b1 \u03c0\u03bf\u03bb\u03bb\u03ad\u03c2 \u03b3\u03bd\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03c3\u03b1 \u03bd\u03b1 \u03b1\u03c0\u03bf\u03ba\u03c4\u03ae\u03c3\u03c9.", "\u03c5\u03c0\u03ae\u03c1\u03c7\u03b1\u03bd \u03c0\u03ac\u03c1\u03b1 \u03c0\u03bf\u03bb\u03bb\u03ad\u03c2 \u03b3\u03bd\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03c3\u03b1 \u03bd\u03b1 \u03b1\u03c0\u03bf\u03ba\u03c4\u03ae\u03c3\u03c9."], ["Audio", "\u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03bf \u03b8\u03ad\u03bb\u03c9 \u03b3\u03b9\u03b1 \u03c4\u03bf\u03c5\u03c2 \u03ac\u03bb\u03bb\u03bf\u03c5\u03c2.", "\u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03bf \u03b8\u03ad\u03bb\u03c9 \u03b3\u03b9\u03b1 \u03c4\u03bf\u03c5\u03c2 \u03ac\u03bb\u03bb\u03bf\u03c5\u03c2."], ["Audio", "\u03ba\u03b1\u03b9 \u03cc, \u03c4\u03b9 \u03b5\u03af\u03c7\u03b5", "\u03ba\u03b1\u03b9 \u03cc, \u03c4\u03b9 \u03b5\u03af\u03c7\u03b5"], ["Audio", "\u03bf\u03b9 \u03ba\u03c1\u03bf\u03ba\u03cc\u03b4\u03b5\u03b9\u03bb\u03bf\u03b9 \u03c4\u03b7\u03c2 \u03b8\u03ac\u03bb\u03b1\u03c3\u03c3\u03b1\u03c2 \u03b4\u03b5\u03bd \u03b5\u03bd\u03b4\u03b9\u03b1\u03b9\u03c4\u03bf\u03cd\u03bd \u03c3\u03c4\u03b7 \u03b8\u03ac\u03bb\u03b1\u03c3\u03c3\u03b1 \u03c4\u03bf \u03b2\u03b1\u03c3\u03b9\u03ba\u03cc \u03c4\u03bf\u03c5\u03c2 \u03c6\u03c5\u03c3\u03b9\u03ba\u03cc \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf\u03b9 \u03b5\u03ba\u03b2\u03bf\u03bb\u03ad\u03c2 \u03c4\u03c9\u03bd \u03c0\u03bf\u03c4\u03b1\u03bc\u03ce\u03bd \u03b2\u03cc\u03c1\u03b5\u03b9\u03b1 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c1\u03cc\u03ba\u03c7\u03b1\u03bc\u03c0\u03c4\u03bf\u03bd", "\u03bf\u03b9 \u03ba\u03bf\u03ba\u03ba\u03cc\u03bc\u03b7\u03b4\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03b8\u03ac\u03bb\u03b1\u03c3\u03c3\u03b1\u03c2 \u03b4\u03b5\u03bd \u03b5\u03bd\u03b4\u03b9\u03b1\u03b9\u03c4\u03bf\u03cd\u03bd \u03c3\u03c4\u03b7 \u03b8\u03ac\u03bb\u03b1\u03c3\u03c3\u03b1 \u03c4\u03bf \u03b2\u03b1\u03c3\u03b9\u03ba\u03cc \u03c4\u03bf\u03c5\u03c2 \u03c6\u03c5\u03c3\u03b9\u03ba\u03cc \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf\u03b9 \u03b5\u03ba\u03b2\u03bf\u03bb\u03ad\u03c2 \u03c4\u03c9\u03bd \u03c0\u03bf\u03c4\u03b1\u03bc\u03ce\u03bd \u03b2\u03cc\u03c1\u03b5\u03b9\u03b1 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c1\u03bf\u03ba\u03c7\u03ac\u03bc\u03c0\u03c4\u03bf\u03bd"], ["Audio", "\u03ba\u03ac\u03c0\u03bf\u03b9\u03bf\u03b9 \u03b1\u03c0\u03cc \u03b1\u03c5\u03c4\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03b1\u03bb\u03b3\u03bf\u03c1\u03af\u03b8\u03bc\u03bf\u03c5\u03c2, \u03bc\u03ac\u03bb\u03b9\u03c3\u03c4\u03b1, \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03bf\u03cd\u03bd \u03b1\u03c5\u03c4\u03cc\u03bd\u03bf\u03bc\u03b1.", "\u03ba\u03ac\u03c0\u03bf\u03b9\u03bf\u03b9 \u03b1\u03c0\u03cc \u03b1\u03c5\u03c4\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03b1\u03bb\u03b3\u03bf\u03c1\u03af\u03b8\u03bc\u03bf\u03c5\u03c2 \u03bc\u03ac\u03bb\u03b9\u03c3\u03c4\u03b1 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03bf\u03cd\u03bd \u03b1\u03c5\u03c4\u03cc\u03bd\u03bf\u03bc\u03b1."], ["Audio", "\u03b3\u03cd\u03c1\u03b9\u03c3\u03b5 \u03c4\u03bf \u03ba\u03b5\u03c6\u03ac\u03bb\u03b9 \u03c3\u03c4\u03b9\u03b3\u03bc\u03b9\u03b1\u03af\u03b1", "\u03b3\u03cd\u03c1\u03b9\u03c3\u03b5 \u03c4\u03bf \u03ba\u03b5\u03c6\u03ac\u03bb\u03b9 \u03c4\u03b7\u03c2 \u03c3\u03c4\u03b9\u03b3\u03bc\u03b9\u03b1\u03af\u03b1"], ["Audio", "\u03c4\u03bf \u03c6\u03b1\u03b3\u03af \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03c4\u03bf\u03b9\u03bc\u03bf, \u03b5\u03af\u03c0\u03b5 \u03c7\u03b1\u03c1\u03bf\u03cd\u03bc\u03b5\u03bd\u03b7", "\u03c4\u03bf \u03c6\u03b1\u03b3\u03af \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03c4\u03bf\u03b9\u03bc\u03bf, \u03b5\u03af\u03c0\u03b5 \u03c7\u03b1\u03c1\u03bf\u03cd\u03bc\u03b5\u03bd\u03b7."]]}